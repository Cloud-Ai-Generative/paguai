{
  "name": "PagUai (.NET 10 + Docker)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    8080,
    8081,
    8082,
    8025,
    15672,
    4010
  ],
  "portsAttributes": {
    "8080": {
      "label": "PagUai (gateway)"
    },
    "8081": {
      "label": "Monólito"
    },
    "8082": {
      "label": "Serviço de Extrato"
    },
    "8025": {
      "label": "Mailpit"
    },
    "15672": {
      "label": "RabbitMQ (interface)"
    },
    "4010": {
      "label": "Mock do contrato (Prism)"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "humao.rest-client",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "dotnet restore"
}

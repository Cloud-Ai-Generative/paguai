{
  "name": "PagUai (.NET 10 + Docker)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080, 8025],
  "portsAttributes": {
    "8080": { "label": "PagUai API" },
    "8025": { "label": "Mailpit" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "humao.rest-client", "ms-azuretools.vscode-docker"]
    }
  },
  "postCreateCommand": "dotnet restore"
}

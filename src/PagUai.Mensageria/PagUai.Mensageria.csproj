<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Biblioteca de INFRAESTRUTURA de mensageria, usada pelo monólito, pelo Extrato e por Notificações.
    Ela só sabe falar com o RabbitMQ (conexão, envelope, filas, retry e dead letter).
    Ela NÃO tem eventos de negócio: o formato de cada evento está no contrato
    contratos/eventos.asyncapi.yaml, e cada serviço lê só os campos de que precisa.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PagUai.Mensageria</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

</Project>

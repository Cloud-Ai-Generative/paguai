<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PagUai.Extrato</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" Version="2.19.0" />
  </ItemGroup>

  <!-- API FIRST: o contrato fica na raiz do repositório e é publicado junto com o serviço. -->
  <ItemGroup>
    <Content Include="..\..\contratos\extrato.openapi.yaml" Link="contratos\extrato.openapi.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
